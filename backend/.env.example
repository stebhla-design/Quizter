# Quizter Backend Environment Variables
# Copy this file to .env and fill in the values

# Required: Google Gemini API Key for AI Quiz Generator
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email (password reset) via Resend HTTP API ---
# Get an API key at https://resend.com (free tier available). Uses HTTPS, so it
# works on hosts that block outbound SMTP (e.g. Render's free plan).
# If RESEND_API_KEY is unset, the reset link is printed to the backend console
# instead of being emailed (dev fallback).
RESEND_API_KEY=your_resend_api_key_here
# From address. "onboarding@resend.dev" works for testing but only delivers to
# your own Resend account email. For real delivery, verify a domain in Resend
# and use e.g. "Quizter <no-reply@yourdomain.com>".
EMAIL_FROM=Quizter <onboarding@resend.dev>

# Base URL of the frontend, used to build the reset link in the email.
FRONTEND_URL=http://localhost:5173
