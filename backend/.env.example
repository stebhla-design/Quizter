# Quizter Backend Environment Variables
# Copy this file to .env and fill in the values

# Required: Google Gemini API Key for AI Quiz Generator
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email (password reset) ---
# Generic SMTP settings. If SMTP_HOST and SMTP_FROM are unset, the reset link
# is printed to the backend console instead of being emailed (dev fallback).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@yourdomain.com
# STARTTLS on port 587 (default). For implicit SSL on port 465, set:
#   SMTP_USE_SSL=true  and  SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Base URL of the frontend, used to build the reset link in the email.
FRONTEND_URL=http://localhost:5173
